APP_ENV=development
ALLOW_FAKE_SERVICES=true
OUTBOUND_PROVIDER=demo
# Local username/password authentication; no email address is required.
AUTH_MODE=local
# Optional system sender for automatic replies and inbound notifications.
# Workspace messages use a selected, server-authorized managed mail address.
OUTBOUND_FROM_EMAIL=dev@example.com
# MAIL_FROM=dev@example.com
OUTBOUND_FROM_NAME=FlareMail
AUTO_REPLY_ENABLED=true
AUTO_REPLY_SUBJECT_PREFIX=Re:
AUTO_REPLY_TEXT=你好，我们已经收到你的邮件，会尽快处理。
INBOUND_NOTIFICATION_ENABLED=true
# Set TELEGRAM_ENABLED=true only in an ignored local .dev.vars after applying
# migrations 0019-0022. Keep the Bot Token out of Git and use a test bot.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_USERNAME=replace_with_bot_username
APP_BASE_URL=http://127.0.0.1:8787
# TELEGRAM_TIMEOUT_MS=5000
# TELEGRAM_BOT_TOKEN=replace-with-local-secret
# Optional independent override; otherwise FlareMail derives it from the Bot Token.
# TELEGRAM_WEBHOOK_SECRET=optional-webhook-secret
# Optional server-only Email Routing Rules API token, scoped to the explicitly
# configured zone(s) with Email Routing Rules Read and Edit (write). Never use
# the deployment token here.
# CLOUDFLARE_EMAIL_ROUTING_TOKEN=
# Domain configuration script inputs (set in the shell only when configuring):
# FLAREMAIL_MAIL_DOMAIN_NAME=example.test
# FLAREMAIL_CLOUDFLARE_ZONE_ID=zone-id
# FLAREMAIL_CLOUDFLARE_ACCOUNT_ID=account-id
# FLAREMAIL_EMAIL_WORKER_NAME=flaremail
# FLAREMAIL_UNKNOWN_RECIPIENT_POLICY=reject
INBOUND_MAX_RAW_BYTES=26214400
INBOUND_MAX_ATTACHMENT_COUNT=50
INBOUND_MAX_ATTACHMENT_BYTES=15728640
INBOUND_MAX_ATTACHMENT_TOTAL_BYTES=25165824
NOTIFICATION_EMAIL=ops@example.com
NOTIFICATION_SUBJECT_PREFIX=[FlareMail] 新入站邮件
