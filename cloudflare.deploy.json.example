{
  "name": "flaremail",
  "compatibilityDate": "2026-08-19",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_ENV": "production",
    "OUTBOUND_PROVIDER": "resend",
    "AUTH_MODE": "local",
    "OUTBOUND_FROM_EMAIL": "flaremail@send.example.com",
    "OUTBOUND_FROM_NAME": "FlareMail",
    "RESEND_API_BASE_URL": "https://api.resend.com",
    "AUTO_REPLY_ENABLED": "true",
    "AUTO_REPLY_SUBJECT_PREFIX": "Re:",
    "AUTO_REPLY_TEXT": "你好，我们已经收到你的邮件，会尽快处理。\n\nThis is an automated reply from FlareMail on Cloudflare Workers.",
    "INBOUND_NOTIFICATION_ENABLED": "true",
    "TELEGRAM_ENABLED": "false",
    "TELEGRAM_BOT_USERNAME": "replace_with_bot_username",
    "APP_BASE_URL": "https://mail.example.com",
    "TELEGRAM_TIMEOUT_MS": "5000",
    "NOTIFICATION_EMAIL": "ops@example.com",
    "NOTIFICATION_SUBJECT_PREFIX": "[FlareMail] 新入站邮件"
  },
  "databaseId": "REPLACE_WITH_REAL_D1_DATABASE_ID",
  "databaseName": "flaremail-db",
  "bucket": "replace-with-your-flaremail-r2-bucket",
  "cron": [
    "* * * * *"
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "headSamplingRate": 0.5
    },
    "traces": {
      "enabled": false,
      "headSamplingRate": 0
    }
  },
  "secrets": [
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "CLOUDFLARE_EMAIL_ROUTING_TOKEN"
  ]
}
