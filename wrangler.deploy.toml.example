name = "flaremail"
main = "worker/index.ts"
compatibility_date = "2026-08-19"
compatibility_flags = ["nodejs_compat"]
# Keep Dashboard-managed variables when the Worker code is deployed.
keep_vars = true

[observability]
enabled = true

[observability.logs]
enabled = true
head_sampling_rate = 0.5

[observability.traces]
# Telegram Bot API tokens are part of the provider URL. Keep tracing disabled
# unless the account's URL redaction/export boundary has been reviewed.
enabled = false
head_sampling_rate = 0

[triggers]
crons = ["* * * * *"]

[vars]
APP_ENV = "production"
OUTBOUND_PROVIDER = "resend"
# Explicitly switch to cloudflare-access after configuring its issuer, AUD,
# JWKS URL, allowed subject, and the stable Owner ID in this same vars block.
AUTH_MODE = "local"
# This sender is only for system auto-replies and inbound notifications.
# User messages select a verified managed address in the workspace.
OUTBOUND_FROM_EMAIL = "flaremail@send.example.com"
OUTBOUND_FROM_NAME = "FlareMail"
RESEND_API_BASE_URL = "https://api.resend.com"
AUTO_REPLY_ENABLED = "true"
AUTO_REPLY_SUBJECT_PREFIX = "Re:"
AUTO_REPLY_TEXT = "你好，我们已经收到你的邮件，会尽快处理。\n\nThis is an automated reply from FlareMail on Cloudflare Workers."
INBOUND_NOTIFICATION_ENABLED = "true"
TELEGRAM_ENABLED = "false"
TELEGRAM_BOT_USERNAME = "replace_with_bot_username"
APP_BASE_URL = "https://mail.example.com"
TELEGRAM_TIMEOUT_MS = "5000"
NOTIFICATION_EMAIL = "ops@example.com"
NOTIFICATION_SUBJECT_PREFIX = "[FlareMail] 新入站邮件"
# Access-only example (replace every value before enabling this mode):
# AUTH_MODE = "cloudflare-access"
# ACCESS_ISSUER = "https://<team>.cloudflareaccess.com"
# ACCESS_AUDIENCE = "<application-aud>"
# ACCESS_JWKS_URL = "https://<team>.cloudflareaccess.com/cdn-cgi/access/certs"
# ACCESS_ALLOWED_SUBJECT = "<single-owner-subject>"
# ACCESS_OWNER_USER_ID = "<stable-workspace-owner-id>"
# Keep CLOUDFLARE_EMAIL_ROUTING_TOKEN in Worker Secrets, scoped to the
# explicitly configured Email Routing zone(s); do not reuse a deploy token.

[assets]
directory = "build"
binding = "ASSETS"

[[d1_databases]]
binding = "DB"
database_name = "flaremail-db"
database_id = "REPLACE_WITH_REAL_D1_DATABASE_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "BUCKET"
bucket_name = "replace-with-your-flaremail-r2-bucket"
