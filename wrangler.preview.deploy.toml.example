# Requires Wrangler >= 4.135.0. Copy to ignored wrangler.preview.deploy.toml.
# Deploy only with `wrangler preview`; `wrangler deploy` targets production.
# This project's Preview shares production data; writes affect production.
name = "flaremail"
main = "worker/index.ts"
compatibility_date = "2026-08-19"
compatibility_flags = ["nodejs_compat"]

[assets]
directory = "build"
binding = "ASSETS"

[previews.vars]
# Copy production's non-secret provider/authentication settings here.
# Keep APP_ENV, APP_BASE_URL and APP_VERSION specific to the Preview.
APP_ENV = "preview"
AUTH_MODE = "local"
OUTBOUND_PROVIDER = "resend"
ALLOW_FAKE_SERVICES = "false"
AUTO_REPLY_ENABLED = "false"
INBOUND_NOTIFICATION_ENABLED = "false"
TELEGRAM_ENABLED = "false"
APP_BASE_URL = "https://mail-identities-flaremail.example.workers.dev"
APP_VERSION = "preview+replace-with-commit"
# Shared data uses the production receiving Worker and its account.
# Email Routing continues to execute production's handler code.
MAIL_IDENTITY_WORKER_NAME = "flaremail"
# MAIL_IDENTITY_ACCOUNT_ID = "replace-with-account-id"

[[previews.d1_databases]]
binding = "DB"
database_name = "replace-with-production-database"
database_id = "replace-with-production-database-id"

[[previews.r2_buckets]]
binding = "BUCKET"
bucket_name = "replace-with-production-bucket"

[previews.observability]
enabled = true
[previews.observability.logs]
enabled = true
[previews.observability.traces]
# Provider URLs may contain notification tokens.
enabled = false
