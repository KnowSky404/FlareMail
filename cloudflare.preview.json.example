{
  "name": "flaremail",
  "compatibilityDate": "2026-08-19",
  "compatibilityFlags": [
    "nodejs_compat"
  ],
  "vars": {
    "APP_ENV": "preview",
    "AUTH_MODE": "local",
    "OUTBOUND_PROVIDER": "resend",
    "ALLOW_FAKE_SERVICES": "false",
    "AUTO_REPLY_ENABLED": "false",
    "INBOUND_NOTIFICATION_ENABLED": "false",
    "TELEGRAM_ENABLED": "false",
    "APP_BASE_URL": "https://mail-ai-flaremail.example.workers.dev",
    "APP_VERSION": "preview+replace-with-commit"
  },
  "databaseId": "replace-with-preview-database-id",
  "databaseName": "replace-with-preview-database",
  "bucket": "replace-with-preview-bucket",
  "cron": [],
  "observability": {
    "enabled": true
  },
  "secrets": [
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "AI_SETTINGS_KEY"
  ]
}
