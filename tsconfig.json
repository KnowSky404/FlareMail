{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "types": [
      "$app/types",
      "bun"
    ],
    "paths": {
      "$lib": [
        "./src/lib"
      ],
      "$lib/*": [
        "./src/lib/*"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "worker",
    "*.ts",
    "*.js",
    "*.mjs"
  ],
  "exclude": [
    "node_modules",
    "build",
    "worker/dist",
    "worker/.cloudflare",
    ".cloudflare"
  ]
}
